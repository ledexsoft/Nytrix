{
  "name": "@nytrix/pty",
  "version": "0.3.2",
  "description": "Persistent PTY service for OpenCode",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/process-daemon/npm"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "opencode-pty": "./bin/opencode-pty.js"
  },
  "files": [
    "bin",
    "index.d.ts",
    "index.js"
  ],
  "optionalDependencies": {
    "@nytrix/pty-darwin-arm64": "0.3.2",
    "@nytrix/pty-darwin-x64": "0.3.2",
    "@nytrix/pty-linux-arm64-gnu": "0.3.2",
    "@nytrix/pty-linux-arm64-musl": "0.3.2",
    "@nytrix/pty-linux-x64-gnu": "0.3.2",
    "@nytrix/pty-linux-x64-musl": "0.3.2",
    "@nytrix/pty-win32-arm64": "0.3.2",
    "@nytrix/pty-win32-x64": "0.3.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
